											"dependsOn": [],
											"policy": {
												"timeout": "0.12:00:00",
												"retry": 2,
												"retryIntervalInSeconds": 30,
												"secureOutput": false,
												"secureInput": false
											},
											"userProperties": [],
											"typeProperties": {
												"source": {
													"type": "PostgreSqlV2Source",
													"query": {
														"value": "select * from PUBLIC.@{activity('Read config details').output.firstRow.source_table_name}\n@{\n    if(equals(activity('Read config details').output.firstRow.load_type,'FULL' ),'' , \n            concat('where ', activity('Read config details').output.firstRow.watermark_column, '>', '''', variables('watermark_value'), '''')\n    \n    )\n}",
														"type": "Expression"
													},
													"queryTimeout": "02:00:00"
												},
												"sink": {
													"type": "ParquetSink",
													"storeSettings": {
														"type": "AzureBlobFSWriteSettings"
													},
													"formatSettings": {
														"type": "ParquetWriteSettings"
													}
												},
												"enableStaging": false,
												"translator": {
													"type": "TabularTranslator",
													"typeConversion": true,
													"typeConversionSettings": {
														"allowDataTruncation": true,
														"treatBooleanAsNumber": false
													}
												}
											},
											"inputs": [
												{
													"referenceName": "ds_postgres",
													"type": "DatasetReference",
													"parameters": {}
												}
											],
											"outputs": [
												{
													"referenceName": "ds_az_adls",
													"type": "DatasetReference",
													"parameters": {
														"container": "landing",
														"folder": {
															"value": "@concat(\n    activity('Read config details').output.firstRow.source_system,\n    '/',\n    activity('Read config details').output.firstRow.source_table_name,\n    '/',\n    variables('start_time')\n)",
															"type": "Expression"
														}
													}
												}
											]
										}
									]
								},
								{
									"value": "adls_csv",
									"activities": [
										{
											"name": "Ingest CSV from source to landing",
											"type": "Copy",
											"dependsOn": [],
											"policy": {
												"timeout": "0.12:00:00",
												"retry": 0,
												"retryIntervalInSeconds": 30,
												"secureOutput": false,
												"secureInput": false
											},
											"userProperties": [],
											"typeProperties": {
												"source": {
													"type": "BinarySource",
													"storeSettings": {
														"type": "AzureBlobFSReadSettings",
														"recursive": false,
														"modifiedDatetimeStart": {
															"value": "@variables('watermark_value')",
															"type": "Expression"
														},
														"deleteFilesAfterCompletion": false
													},
													"formatSettings": {
														"type": "BinaryReadSettings"
													}
												},
												"sink": {
													"type": "BinarySink",
													"storeSettings": {
														"type": "AzureBlobFSWriteSettings"
													}
												},
												"enableStaging": false
											},
											"inputs": [
												{
													"referenceName": "ds_adls_csv_binary",
													"type": "DatasetReference",
													"parameters": {
														"container": "source",
														"folder": {
															"value": "@activity('Read config details').output.firstRow.source_path",
															"type": "Expression"
														}
													}
												}
											],
											"outputs": [
												{
													"referenceName": "ds_adls_csv_binary",
													"type": "DatasetReference",
													"parameters": {
														"container": "landing",
														"folder": {
															"value": "@concat(\n    activity('Read config details').output.firstRow.source_system,\n    '/',\n    activity('Read config details').output.firstRow.source_table_name,\n    '/',\n    variables('start_time')\n)\n",
															"type": "Expression"
														}
													}
												}
											]
										}
									]
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"table_id": {
						"type": "string"
					},
					"adf_run_id": {
						"type": "string"
					}
				},
				"variables": {
					"start_time": {
						"type": "String"
					},
					"watermark_value": {
						"type": "String"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_az_sql')]",
				"[concat(variables('factoryId'), '/linkedServices/ls_databricks')]",
				"[concat(variables('factoryId'), '/linkedServices/ls_az_sql')]",
				"[concat(variables('factoryId'), '/datasets/ds_postgres')]",
				"[concat(variables('factoryId'), '/datasets/ds_az_adls')]",
