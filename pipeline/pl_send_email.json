{
	"name": "pl_send_email",
	"properties": {
		"activities": [
			{
				"name": "Read all table status",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from ctrl.audit_log where adf_run_id='@{pipeline().parameters.adf_run_id}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_az_sql",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Prepare email body header",
				"description": "",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body_header",
					"value": "Ingestion and transformation process for caresync project has been completed and below is the status: "
				}
			},
			{
				"name": "Prepare email body footer",
				"description": "",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body_footer",
					"value": "For any support please reach out to abc@gmail.com"
				}
			},
			{
				"name": "Prepare email subject",
				"description": "",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Check overall failed count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_subject",
					"value": {
						"value": "@{pipeline().globalParameters.env} | @{if(greater(activity('Check overall failed count').output.firstRow.count, 0),'FAILED','SUCCESS')} | CARESYNC MASTER RUN",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Check overall failed count",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select count(*) as count \nfrom ctrl.audit_log where adf_run_id='@{pipeline().parameters.adf_run_id}'\nand status !='SUCCESS'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_az_sql",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Prepare logic apps body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Prepare email subject",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Prepare email body footer",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Prepare email body header",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Read all table status",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logic_apps_body",
					"value": {
						"value": "{\n  \"subject\": \"@{variables('email_subject')}\",\n  \"email_recipients\": \"@{pipeline().globalParameters.email_recipient}\",\n  \"body_header\": \"@{variables('body_header')}\",\n  \"body_footer\": \"@{variables('body_footer')}\",\n  \"status_table\": @{activity('Read all table status').output.value}\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Send email",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Prepare logic apps body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": {
						"value": "@pipeline().globalParameters.logic_apps_url",
						"type": "Expression"
					},
					"body": {
						"value": "@variables('logic_apps_body')",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"adf_run_id": {
				"type": "string"
			}
		},
		"variables": {
			"body_header": {
				"type": "String"
			},
			"email_subject": {
				"type": "String"
			},
			"logic_apps_body": {
				"type": "String"
			},
			"body_footer": {
				"type": "String"
			}
		},
		"annotations": []
	}
}